{
  "name": "node-eventloop-watchdog",
  "version": "1.1.0",
  "description": "Production watchdog that detects Node.js event loop stalls and can trigger recovery actions before your app silently freezes",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "lint": "node scripts/check-syntax.js",
    "typecheck": "tsc --noEmit",
    "build": "npm pack --dry-run",
    "test": "node test/index.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html node test/index.test.js",
    "test:coverage:check": "c8 --check-coverage --lines 90 --functions 90 --branches 90 --statements 90 --reporter=text node test/index.test.js",
    "bench": "node bench/overhead.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage:check"
  },
  "devDependencies": {
    "c8": "^8.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "event-loop",
    "blocking",
    "detection",
    "monitor",
    "performance",
    "diagnostics",
    "latency",
    "watchdog",
    "production",
    "nodejs",
    "observability",
    "profiler",
    "debugging"
  ],
  "author": "beingmartinbmc",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beingmartinbmc/node-eventloop-watchdog.git"
  },
  "bugs": {
    "url": "https://github.com/beingmartinbmc/node-eventloop-watchdog/issues"
  },
  "homepage": "https://github.com/beingmartinbmc/node-eventloop-watchdog#readme"
}
